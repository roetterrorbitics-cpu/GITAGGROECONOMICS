# Server-side only. Never expose these values to browser JavaScript.
PAYPAL_CLIENT_ID=replace-with-live-client-id
PAYPAL_CLIENT_SECRET=replace-with-live-client-secret
PAYPAL_PLAN_ID_CREATOR=replace-with-paypal-plan-id
PAYPAL_PLAN_ID_PRO=replace-with-paypal-plan-id
PAYPAL_WEBHOOK_ID=replace-with-webhook-id
PAYPAL_RETURN_URL=https://your-production-domain.example/
PAYPAL_CANCEL_URL=https://your-production-domain.example/
PAYPAL_ENVIRONMENT=sandbox
